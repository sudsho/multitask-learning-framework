# Optional: where to find a trained NLP / vision checkpoint at serve time.
# If unset, the API responds with dummy outputs (useful for shape testing).
MTL_NLP_CKPT=runs/nlp/best.pt
MTL_VISION_CKPT=runs/vision/best.pt

# MLflow tracking URI (point at the compose service in dev).
MLFLOW_TRACKING_URI=http://localhost:5000
